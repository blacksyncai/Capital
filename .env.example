# Cross-Broker Trading System Environment Configuration

# ============================================================================
# IMPORTANT: This file contains SENSITIVE information.
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL connection (Local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cross_broker_trading
DB_USER=cross_broker_user
DB_PASSWORD=your_secure_password_here

# Alternative: Railway or other cloud PostgreSQL
# DB_HOST=your-railway-hostname
# DB_PORT=5432
# DB_NAME=railway
# DB_USER=postgres
# DB_PASSWORD=your-railway-password
# DB_SSL_MODE=require

# ============================================================================
# BROKER CONFIGURATION - Vantage Markets
# ============================================================================

# Vantage Demo Account
VANTAGE_LOGIN=12345678
VANTAGE_PASSWORD=your_vantage_demo_password
VANTAGE_SERVER=Vantage-Demo
VANTAGE_SERVER_ADDRESS=54.254.150.105:443
VANTAGE_ACCOUNT_TYPE=DEMO

# Vantage Live Account (Disabled by default)
# VANTAGE_LIVE_LOGIN=12345678
# VANTAGE_LIVE_PASSWORD=your_vantage_live_password
# VANTAGE_LIVE_SERVER=Vantage-Live
# VANTAGE_LIVE_ACCOUNT_TYPE=REAL

# ============================================================================
# BROKER CONFIGURATION - JustMarkets
# ============================================================================

# JustMarkets Demo Account
JUSTMARKETS_LOGIN=87654321
JUSTMARKETS_PASSWORD=your_justmarkets_demo_password
JUSTMARKETS_SERVER=JustMarkets-Demo
JUSTMARKETS_SERVER_ADDRESS=185.141.63.241:443
JUSTMARKETS_ACCOUNT_TYPE=DEMO

# JustMarkets Live Account (Disabled by default)
# JUSTMARKETS_LIVE_LOGIN=87654321
# JUSTMARKETS_LIVE_PASSWORD=your_justmarkets_live_password
# JUSTMARKETS_LIVE_SERVER=JustMarkets-Live
# JUSTMARKETS_LIVE_ACCOUNT_TYPE=REAL

# ============================================================================
# MT5 TERMINAL PATHS (Windows only)
# ============================================================================

# Path to Vantage MT5 terminal executable
VANTAGE_MT5_PATH=C:/Program Files/Vantage MT5/terminal64.exe

# Path to JustMarkets MT5 terminal executable
JUSTMARKETS_MT5_PATH=C:/Program Files/JustMarkets MT5/terminal64.exe

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================

# Primary instrument
PRIMARY_INSTRUMENT=XAUUSD

# Initial lot size per broker
INITIAL_LOT_SIZE=0.01

# Default trading mode (DEMO, SIMULATION, LIVE - LIVE disabled by default)
TRADING_MODE=DEMO

# Enable/disable live trading (MUST be false for demo)
LIVE_TRADING_ENABLED=false

# ============================================================================
# RISK PARAMETERS (Conservative defaults)
# ============================================================================

# Maximum loss per paired cycle (USD)
MAX_LOSS_PER_CYCLE=10.0

# Maximum daily loss (USD)
MAX_DAILY_LOSS=50.0

# Maximum open exposure per broker (USD)
MAX_OPEN_EXPOSURE=100.0

# Maximum holding time per trade (hours)
MAX_HOLDING_TIME_HOURS=24

# Minimum free margin percentage
MIN_FREE_MARGIN_PERCENT=50.0

# Maximum acceptable spread (points)
MAX_SPREAD_POINTS=10

# Maximum acceptable execution delay (seconds)
MAX_EXECUTION_DELAY_SECONDS=5

# Maximum slippage (points)
MAX_SLIPPAGE_POINTS=5

# ============================================================================
# IB REBATE CONFIGURATION
# ============================================================================

# Vantage IB Rebate per standard lot (USD)
VANTAGE_REBATE_PER_LOT=10.0
VANTAGE_MIN_HOLDING_TIME_MINUTES=5
VANTAGE_ELIGIBLE_INSTRUMENTS=XAUUSD,XAGUSD,BTCUSD,ETHUSD

# JustMarkets IB Rebate per standard lot (USD)
JUSTMARKETS_REBATE_PER_LOT=8.0
JUSTMARKETS_MIN_HOLDING_TIME_MINUTES=5
JUSTMARKETS_ELIGIBLE_INSTRUMENTS=XAUUSD,XAGUSD,BTCUSD,ETHUSD

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file paths
EXECUTION_LOG_PATH=logs/execution.log
RISK_LOG_PATH=logs/risk.log
STRATEGY_LOG_PATH=logs/strategy.log
MARKET_DATA_LOG_PATH=logs/market_data.log

# ============================================================================
# DASHBOARD CONFIGURATION
# ============================================================================

# Dashboard host and port
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8000

# Enable dashboard authentication
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your_dashboard_password

# ============================================================================
# API KEYS (Optional for external services)
# ============================================================================

# Cerebras API key (for AI inference)
# CEREBRAS_API_KEY=your-cerebras-api-key

# Other AI provider keys
# OPENAI_API_KEY=your-openai-api-key

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable market data recording
ENABLE_MARKET_DATA_RECORDING=true

# Enable strategy backtesting
ENABLE_BACKTESTING=true

# Enable AI research module
ENABLE_AI_RESEARCH=false

# Enable emergency stop override (for testing only)
ENABLE_EMERGENCY_STOP_OVERRIDE=false

# ============================================================================
# NOTES
# ============================================================================

# 1. For MetaTrader5 Python package:
#    - Download from: https://www.mql5.com/en/docs/integration/python_metatrader5
#    - Install: pip install MetaTrader5-*.whl
#    - OR: pip install MetaTrader5
#
# 2. MT5 Terminal Requirements:
#    - Two separate MT5 terminals must be installed
#    - One for Vantage, one for JustMarkets
#    - Both must be running before starting the system
#    - Terminal paths must be correct in MT5_PATH variables
#
# 3. Broker Server Addresses:
#    - Verify with your broker as they may change
#    - Vantage: Check MT5 login screen or broker documentation
#    - JustMarkets: Check MT5 login screen or broker documentation
#
# 4. Account Creation:
#    - Open demo accounts with both brokers
#    - Note: Demo accounts typically expire after 30 days
#    - Request new demo accounts as needed
#
# 5. Live Trading Requirements:
#    - LIVE_TRADING_ENABLED must be explicitly set to true
#    - TRADING_MODE must be set to LIVE
#    - All risk parameters must be reviewed and approved
#    - Preflight check must pass before any live trades
#
# 6. Security:
#    - Never share your .env file
#    - Use strong, unique passwords for all accounts
#    - Enable 2FA on all broker accounts
#    - Regularly rotate credentials
